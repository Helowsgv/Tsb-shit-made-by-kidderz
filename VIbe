--// Press MINUS (-) to stop everything and restore settings.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local VirtualInputManager = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer

--==================================================
-- MASTER CONTROL
--==================================================

local Active = true
local Connections = {}
local CleanupFunctions = {}

local function Connect(signal, callback)
    local connection = signal:Connect(function(...)
        if Active then
            callback(...)
        end
    end)

    table.insert(Connections, connection)
    return connection
end

local function AddCleanup(callback)
    table.insert(CleanupFunctions, callback)
end

local function StopEverything()
    if not Active then return end

    Active = false

    -- Disconnect every registered connection
    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    -- Run every restoration function
    for _, callback in ipairs(CleanupFunctions) do
        pcall(callback)
    end

    table.clear(CleanupFunctions)

    print("[MASTER] All scripts stopped. Settings restored where possible.")
end

Connect(UserInputService.InputBegan, function(input, processed)
    if input.KeyCode == Enum.KeyCode.Minus then
        StopEverything()
    end
end)

