-- SCRIPT 2: KILL SOUND
--==================================================

do
    local LiveFolder = Workspace:WaitForChild("Live")

    local LastDamageValue = 0
    local KillSoundOnCooldown = false
    local RecentlyKilled = {}
    local CreatedSounds = {}

    local function PlayKillSound(targetHRP)
        if not targetHRP or not Active then return end

        local sound = Instance.new("Sound")
        sound.Name = "KillSound"
        sound.SoundId = "rbxassetid://131961137"
        sound.Volume = 3
        sound.EmitterSize = 10
        sound.RollOffMode = Enum.RollOffMode.InverseTapered
        sound.MaxDistance = 250
        sound.Looped = false
        sound.Parent = targetHRP

        local reverb = Instance.new("ReverbSoundEffect")
        reverb.DecayTime = 2
        reverb.Density = 0.5
        reverb.Diffusion = 0.9
        reverb.WetLevel = -10
        reverb.DryLevel = 0
        reverb.Parent = sound

        CreatedSounds[sound] = true

        sound:Play()
        Debris:AddItem(sound, 5)

        KillSoundOnCooldown = true

        task.delay(3, function()
            if Active then
                KillSoundOnCooldown = false
            end
        end)
    end

    local function WatchTargetRespawn(model)
        local name = model.Name

        if RecentlyKilled[name] == "watching" then
            return
        end

        RecentlyKilled[name] = "watching"

        local humanoid = model:FindFirstChildWhichIsA("Humanoid")

        if humanoid then
            Connect(humanoid.Died, function()
                task.delay(1.5, function()
                    if Active then
                        RecentlyKilled[name] = nil
                    end
                end)
            end)
        end

        Connect(model.ChildRemoved, function(child)
            if child:IsA("Humanoid") then
                RecentlyKilled[name] = nil
            end
        end)
    end

    Connect(RunService.Heartbeat, function()
        local myModel = LiveFolder:FindFirstChild(Player.Name)
        if not myModel then return end

        local fullValue = myModel:GetAttribute("LastM1Hitted")
        local currentDamage = myModel:GetAttribute("LastDamageDone")

        local targetName

        if fullValue then
            local parts = string.split(fullValue, ";;")
            targetName = parts[1]
        end

        if targetName and currentDamage and currentDamage ~= LastDamageValue then
            local targetModel = LiveFolder:FindFirstChild(targetName)

            if targetModel then
                local humanoid = targetModel:FindFirstChildWhichIsA("Humanoid")
                local lastHit = targetModel:GetAttribute("LastHit")
                local hrp = targetModel:FindFirstChild("HumanoidRootPart")

                if lastHit == Player.Name and humanoid and humanoid.Health <= 0 then
                    if not KillSoundOnCooldown
                        and RecentlyKilled[targetName] ~= true
                        and hrp then

                        PlayKillSound(hrp)
                        RecentlyKilled[targetName] = true
                        WatchTargetRespawn(targetModel)
                    end
                end
            end
        end

        LastDamageValue = currentDamage
    end)

    Connect(Player.CharacterAdded, function()
        LastDamageValue = 0
        RecentlyKilled = {}
        KillSoundOnCooldown = false
    end)

    AddCleanup(function()
        for sound in pairs(CreatedSounds) do
            pcall(function()
                sound:Destroy()
            end)
        end

        table.clear(CreatedSounds)
        table.clear(RecentlyKilled)
    end)
end

