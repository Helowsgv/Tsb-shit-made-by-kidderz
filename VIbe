-- SCRIPT 4: BACKDASH SKILLZ
--==================================================

do
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    local STARE_DURATION = 1
    local MAX_DISTANCE = 30
    local MAX_VELOCITY = 100
    local PREDICTION_TIME = 0.25
    local SLOWED_TIMEOUT = 0.6
    local FREEZE_TIMEOUT = 0.5

    local isSHeld = false
    local isRagdolled = false

    local RagdollConnections = {}

    local function DisconnectRagdollConnections()
        for _, connection in ipairs(RagdollConnections) do
            connection:Disconnect()
        end

        table.clear(RagdollConnections)
    end

    local function getNearestTarget()
        local live = Workspace:FindFirstChild("Live")
        if not live or not rootPart then return nil end

        local closest, shortest = nil, MAX_DISTANCE

        for _, model in ipairs(live:GetChildren()) do
            if model:IsA("Model") and model.Name ~= Player.Name then
                local hrp = model:FindFirstChild("HumanoidRootPart")

                if hrp then
                    local dist = (rootPart.Position - hrp.Position).Magnitude

                    if dist < shortest then
                        shortest = dist
                        closest = hrp
                    end
                end
            end
        end

        return closest
    end

    local function pressQ()
        if not Active then return end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
    end

    local function stareMethodA(targetRoot)
        if not targetRoot or not humanoid or not rootPart then return end

        local currentHumanoid = humanoid
        currentHumanoid.AutoRotate = false

        local elapsed = 0
        local connection

        connection = RunService.RenderStepped:Connect(function(dt)
            if not Active then
                connection:Disconnect()
                return
            end

            if isRagdolled then
                currentHumanoid.AutoRotate = true
                connection:Disconnect()
                return
            end

            if not targetRoot.Parent or not rootPart.Parent then
                currentHumanoid.AutoRotate = true
                connection:Disconnect()
                return
            end

            elapsed += dt

            if elapsed >= STARE_DURATION then
                currentHumanoid.AutoRotate = true
                connection:Disconnect()
                return
            end

            local velocity = targetRoot.Velocity

            if velocity.Magnitude > MAX_VELOCITY then
                velocity = Vector3.zero
            end

            local predicted = targetRoot.Position + velocity * PREDICTION_TIME
            local lookAt = Vector3.new(predicted.X, rootPart.Position.Y, predicted.Z)

            rootPart.CFrame = CFrame.lookAt(rootPart.Position, lookAt)
        end)

        table.insert(Connections, connection)
    end

    local function stareMethodB(targetRoot)
        if not targetRoot or not humanoid or not rootPart then return end

        local currentHumanoid = humanoid
        currentHumanoid.AutoRotate = false

        local velocity = targetRoot.Velocity

        if velocity.Magnitude > MAX_VELOCITY then
            velocity = Vector3.zero
        end

        local predicted = targetRoot.Position + velocity * PREDICTION_TIME
        local lookAt = Vector3.new(predicted.X, rootPart.Position.Y, predicted.Z)

        rootPart.CFrame = CFrame.lookAt(rootPart.Position, lookAt)

        task.delay(STARE_DURATION, function()
            if Active and currentHumanoid.Parent then
                currentHumanoid.AutoRotate = true
            end
        end)
    end

    local function getLiveModel()
        local live = Workspace:FindFirstChild("Live")
        return live and live:FindFirstChild(Player.Name)
    end

    local function setupRagdollWatcher()
        DisconnectRagdollConnections()

        local live = getLiveModel()
        if not live then return end

        isRagdolled = live:FindFirstChild("Ragdoll") ~= nil

        table.insert(RagdollConnections, live.ChildAdded:Connect(function(child)
            if child.Name == "Ragdoll" then
                isRagdolled = true
            end
        end))

        table.insert(RagdollConnections, live.ChildRemoved:Connect(function(child)
            if child.Name == "Ragdoll" then
                isRagdolled = false
            end
        end))
    end

    local function hasSlowed()
        local model = getLiveModel()
        return model and model:FindFirstChild("Slowed")
    end

    local function hasFreeze()
        local model = getLiveModel()
        return model and model:FindFirstChild("Freeze")
    end

    local function waitForSlowed(timeout)
        local t = 0

        while Active and t < timeout do
            if hasSlowed() then return true end
            task.wait(0.05)
            t += 0.05
        end

        return false
    end

    local function waitForFreeze(timeout)
        local t = 0

        while Active and t < timeout do
            if hasFreeze() then return true end
            task.wait(0.05)
            t += 0.05
        end

        return false
    end

    Connect(UserInputService.InputBegan, function(input, processed)
        if processed then return end

        if input.KeyCode == Enum.KeyCode.S then
            isSHeld = true
        end

        local numberKeys = {
            [Enum.KeyCode.One] = true,
            [Enum.KeyCode.Two] = true,
            [Enum.KeyCode.Three] = true,
            [Enum.KeyCode.Four] = true
        }

        if isSHeld and numberKeys[input.KeyCode] then
            local target = getNearestTarget()
            if not target then return end

            pressQ()

            task.spawn(function()
                if not Active then return end

                local trueCombo = false

                if input.KeyCode == Enum.KeyCode.One
                    or input.KeyCode == Enum.KeyCode.Four then

                    trueCombo = waitForFreeze(FREEZE_TIMEOUT)

                elseif input.KeyCode == Enum.KeyCode.Two
                    or input.KeyCode == Enum.KeyCode.Three then

                    trueCombo = waitForSlowed(SLOWED_TIMEOUT)
                end

                if not Active or not trueCombo then return end

                if input.KeyCode == Enum.KeyCode.One
                    or input.KeyCode == Enum.KeyCode.Four then

                    stareMethodB(target)
                else
                    stareMethodA(target)
                end
            end)
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.KeyCode == Enum.KeyCode.S then
            isSHeld = false
        end
    end)

    local function updateCharacter(char)
        if humanoid then
            humanoid.AutoRotate = true
        end

        character = char
        humanoid = char:WaitForChild("Humanoid")
        rootPart = char:WaitForChild("HumanoidRootPart")

        isSHeld = false
        isRagdolled = false

        task.delay(0.5, function()
            if Active then
                setupRagdollWatcher()
            end
        end)
    end

    Connect(Player.CharacterAdded, updateCharacter)

    setupRagdollWatcher()

    AddCleanup(function()
        isSHeld = false
        isRagdolled = false

        DisconnectRagdollConnections()

        if humanoid then
            humanoid.AutoRotate = true
        end
    end)
end

--==================================================
-- SCRIPT 5: FPS BOOST / TSB OPTIMIZER
--==================================================

do
    local Original = {
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        FogStart = Lighting.FogStart,
        FogEnd = Lighting.FogEnd,
        Parts = {},
        Sky = nil
    }

    local function SaveAndApply(obj)
        if Original.Parts[obj] then return end

        if obj:IsA("BasePart") then
            Original.Parts[obj] = {
                Type = "Part",
                Material = obj.Material
            }

            if obj:IsA("MeshPart") then
                Original.Parts[obj].TextureID = obj.TextureID
                obj.TextureID = ""
            end

            obj.Material = Enum.Material.SmoothPlastic

        elseif obj:IsA("Texture") or obj:IsA("Decal") then
            Original.Parts[obj] = {
                Type = "Texture",
                Transparency = obj.Transparency
            }

            obj.Transparency = 1
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(SaveAndApply, obj)
    end

    Connect(Workspace.DescendantAdded, function(obj)
        pcall(SaveAndApply, obj)
    end)

    Lighting.GlobalShadows = false
    Lighting.EnvironmentSpecularScale = 0
    Lighting.EnvironmentDiffuseScale = 0

    local sky = Lighting:FindFirstChildOfClass("Sky")

    if sky then
        Original.Sky = sky
        sky.Parent = nil
    end

    pcall(function()
        RunService:Set3DRenderingEnabled(false)
    end)

    AddCleanup(function()
        -- Restore materials and textures
        for obj, data in pairs(Original.Parts) do
            if obj and obj.Parent then
                pcall(function()
                    if data.Type == "Part" then
                        obj.Material = data.Material

                        if data.TextureID ~= nil then
                            obj.TextureID = data.TextureID
                        end

                    elseif data.Type == "Texture" then
                        obj.Transparency = data.Transparency
                    end
                end)
            end
        end

        -- Restore lighting
        Lighting.GlobalShadows = Original.GlobalShadows
        Lighting.EnvironmentSpecularScale = Original.EnvironmentSpecularScale
        Lighting.EnvironmentDiffuseScale = Original.EnvironmentDiffuseScale
        Lighting.FogStart = Original.FogStart
        Lighting.FogEnd = Original.FogEnd

        -- Restore sky
        if Original.Sky then
            pcall(function()
                Original.Sky.Parent = Lighting
            end)
        end

        -- Restore 3D rendering
        pcall(function()
            RunService:Set3DRenderingEnabled(true)
        end)

        table.clear(Original.Parts)
    end)
end

--==================================================
-- SCRIPT 6: +0.5 STUD DASH
--==================================================

do
    local MOVE_DISTANCE = 0.5
    local PAIR_WINDOW = 0.4

    local HRP
    local MyModel

    local LastDashTime
    local LastM1Time

    local CharacterConnections = {}

    local function DisconnectCharacterConnections()
        for _, connection in ipairs(CharacterConnections) do
            connection:Disconnect()
        end

        table.clear(CharacterConnections)
    end

    local function MoveForward()
        if not Active or not HRP or not HRP.Parent then
            return
        end

        HRP.CFrame = HRP.CFrame + (HRP.CFrame.LookVector * MOVE_DISTANCE)

        print("[Dash TP] SUCCESS: Dash + M1 detected! Moved 0.5 studs forward.")
    end

    local function CheckPair()
        if not LastDashTime or not LastM1Time then
            return
        end

        local difference = math.abs(LastDashTime - LastM1Time)

        if difference <= PAIR_WINDOW then
            LastDashTime = nil
            LastM1Time = nil

            MoveForward()
        end
    end

    local function OnDashChanged(direction)
        if not Active then return end

        LastDashTime = os.clock()

        print("[Dash TP] Confirmed " .. direction .. " Dash!")

        CheckPair()
    end

    local function OnM1Changed()
        if not Active then return end

        LastM1Time = os.clock()

        print("[Dash TP] Actual M1 detected! LastM1Fire changed.")

        CheckPair()
    end

    local function BindCharacter()
        DisconnectCharacterConnections()

        LastDashTime = nil
        LastM1Time = nil

        local liveFolder = Workspace:WaitForChild("Live", 10)
        if not Active or not liveFolder then return end

        MyModel = liveFolder:WaitForChild(Player.Name, 10)
        if not Active or not MyModel then return end

        HRP = MyModel:WaitForChild("HumanoidRootPart", 10)
        if not Active or not HRP then return end

        table.insert(CharacterConnections,
            MyModel:GetAttributeChangedSignal("JustLeftDashed"):Connect(function()
                OnDashChanged("LEFT")
            end)
        )

        table.insert(CharacterConnections,
            MyModel:GetAttributeChangedSignal("JustRightDashed"):Connect(function()
                OnDashChanged("RIGHT")
            end)
        )

        table.insert(CharacterConnections,
            MyModel:GetAttributeChangedSignal("LastM1Fire"):Connect(OnM1Changed)
        )

        print("[Dash TP] Trackers connected successfully.")
    end

    task.spawn(function()
        if Player.Character then
            BindCharacter()
        end
    end)

    Connect(Player.CharacterAdded, function()
        task.wait(0.5)

        if Active then
            BindCharacter()
        end
    end)

    AddCleanup(function()
        DisconnectCharacterConnections()

        LastDashTime = nil
        LastM1Time = nil

        HRP = nil
        MyModel = nil
    end)
end

